<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #F3F4F6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.localride.controller.DashboardController">
    <left>
            <VBox fx:id="menuBox" prefWidth="200.0" style="-fx-backgrund-color: #1E3A8A" alignment="CENTER" spacing="10.0">
                <padding>
                    <Insets bottom="20.0" left="10.0" right="20.0" />
                </padding>
				<children>
                    <Button fx:id="loginButton" text="Login" styleClass="menu-button" onAction="#showLogin" prefWidth="180.0"/>
                    <Button fx:id="addPassengerButton" text="Add Passenger" styleClass="menu-button" onAction="#showAddPassenger" prefWidth="180.0" disable="true"/>
                    <Button fx:id="listPassengersButton" text="List Passengers" styleClass="menu-button" onAction="#showListPassengers" prefWidth="180.0"/>
                    <Button fx:id="addDriverButton" text="Add Driver" styleClass="menu-button" onAction="#showAddDriver" prefWidth="180.0" disable="true"/>
                    <Button fx:id="listDriversButton" text="List Drivers" styleClass="menu-button" onAction="#showListDrivers" prefWidth="180.0"/>
                    <Button fx:id="listRidesButton" text="List Rides" styleClass="menu-button" onAction="#showListRides" prefWidth="180.0"/>
                    <Button fx:id="rideRequestsButton" text="Ride Requests" styleClass="menu-button" onAction="#showRideRequests" prefWidth="180.0"/>
                    <Button fx:id="activeRidesButton" text="Active Rides" styleClass="menu-button" onAction="#showActiveRides" prefWidth="180.0"/>
                    <Button fx:id="profileButton" text="Profile" styleClass="menu-button" onAction="#showProfile" prefWidth="180.0" visible="false"/>
                </children>

			</VBox>
    </left>
    <center>
        <Pane fx:id="contentPane" prefHeight="600.0" prefWidth="600.0">
        <Label text="Dashboard Content Goes Here" style="-fx-font-size: 24px; -fx-text-fill: #333;"/>
        </Pane>
    </center>
    <bottom>
        <Label text="Footer Information" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
    </bottom>
</BorderPane>