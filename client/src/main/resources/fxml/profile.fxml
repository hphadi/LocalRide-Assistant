<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #F3F4F6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.localride.controller.ProfileController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>
    <children>
        <Label fx:id="nameLabel" style="-fx-font-size: 24; -fx-text-fill: #1E3A8A; -fx-font-weight: bold;">
            <font>
                <Font name="Arial" size="24.0"/>
            </font>
        </Label>
        <Label fx:id="roleLabel" style="-fx-font-size: 18; -fx-text-fill: #6B7280;"/>
        <Label text="Ride History: Coming soon" style="-fx-font-size: 16; -fx-text-fill: #6B7280;"/>
    </children>
</VBox>
